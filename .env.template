# OISSU CONNECT — backend environment configuration
# Copy to `.env` and adjust. Every value has a sane default in
# backend/core/conf.py, so you only need to override what differs.
#
# When running with docker-compose, the database/redis/minio hosts are
# overridden to the container service names by the compose file, so the
# localhost values below are meant for bare-metal local development.

# Environment is forced to `preprod` by docker-compose.override.yml on this
# branch. The settings validator then REFUSES to boot while any development
# default is still in place below — that is deliberate.
ENVIRONMENT=preprod

# Image pulled from GHCR. Pin a commit with :sha-xxxxxxx when you need to.
API_IMAGE=ghcr.io/shalom-302/backendoissu:staging

# --- Frontend / CORS ---
# NOTE — the app itself does not need this. The browser only ever talks to the
# Next.js server, which proxies to the API server-side, so every browser request
# is same-origin and no pre-flight happens. This list matters only for something
# calling the API directly from a browser: a third-party tool, or a future
# client that drops the proxy.
#
# Origins allowed to call the API, as a JSON list, without a trailing slash.
# The API answers with credentials (refresh-token cookie), so '*' is not an
# option: list the real frontend origins.
#
# This API is served at https://oissu-api.kortex.sbs — that is NOT what goes
# here. What goes here is the FRONTEND's origin.
#   dev      ["http://localhost:3000"]
#   staging  ["https://staging.oissu-connect.example"]
CORS_ALLOWED_ORIGINS=["https://REMPLACEZ-PAR-LE-DOMAINE-DU-FRONT"]
CLIENT_URL=https://REMPLACEZ-PAR-LE-DOMAINE-DU-FRONT

# Refresh-token cookie. Same-site front/back (localhost:3000 -> localhost:8000)
# works with 'lax'. For a cross-domain deployment use 'none' AND COOKIE_SECURE=true
# (browsers reject SameSite=None without Secure).
# The frontend is on another domain in staging, so the refresh cookie must be
# SameSite=None — and browsers reject that without Secure.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- Database (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEZ-MOI
POSTGRES_DATABASE=oissu

# Auto-create tables on startup (dev only). Set to false in production and use
# Alembic migrations instead.
DB_AUTO_CREATE=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- Object storage (MinIO / S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGEZ-MOI
MINIO_BUCKET_NAME=oissu
MINIO_CLOUD_URL=http://localhost:9000

# --- Secrets ---
# These dev defaults are fine for local work. Outside dev (ENVIRONMENT=preprod|prod)
# the server REFUSES to start until you replace them — along with POSTGRES_PASSWORD
# and MINIO_SECRET_KEY below.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET_KEY=CHANGEZ-MOI
# python -c "import os; print(os.urandom(32).hex())"
OPERA_LOG_ENCRYPT_SECRET_KEY=CHANGEZ-MOI

# --- Demonstration data ---
# The seed refuses to run outside ENVIRONMENT=dev. If you deliberately want the
# pitch dataset on a throwaway staging database, set OISSU_SEED_FORCE=1 and
# real ADMIN_* values — never point it at a database holding real athletes.

# --- Optional: SMTP / email (leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# --- Optional: Google SSO ---
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
GOOGLE_WEBHOOK_OAUTH_REDIRECT_URI=

# --- Optional: external geo-IP lookup on each request (off by default) ---
# false  = disabled (recommended; no third-party call)
# online = sends each client IP to ip-api.com over HTTP (privacy + latency)
# offline = needs backend/static/ip2region.xdb (~11MB, not shipped)
IP_LOCATION_PARSE=false

# --- Optional: Observability (Prometheus / OpenTelemetry) ---
OBSERVABILITY_ENABLED=false
OTLP_GRPC_ENDPOINT=
